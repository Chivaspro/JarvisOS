# ── Secrets — never commit ───────────────────────────────────────────────
config/api_keys.json
config/certs/
.env
*.pem
*.key

# ── Node (Agent TARS runtime) ────────────────────────────────────────────
# node_modules is installed from package.json/package-lock.json; the lockfile
# itself is committed so the pinned Agent TARS runtime is reproducible.
node_modules/
npm-debug.log*
data/agent_tars_workspace/

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
# One dedicated home for every cache / temp / test-scratch artifact.
/.cache/
# Local model weights (the ~600 MB laya-multilingual tree). Downloaded, not
# source; pytest.ini and CI both exclude it from collection/compileall.
# Root-anchored so data/models/ (the bundled vision model) stays committed.
/models/

# ── Native (Rust) build artifacts ────────────────────────────────────────
# The optional jarvis_native extension: source lives in native/, everything
# generated (cargo target dir, the copied .pyd, its probe files) is local-only.
# Releases ship the .pyd inside the package; dev machines build it with
# tools/build_native.py. The app falls back to pure Python without it.
native/target/
native/jarvis_native*.pyd
native/jarvis_native*.dll
native/Cargo.lock

# ── Runtime state ────────────────────────────────────────────────────────
memory/*.json
*.log
config/backups/
config/runtime_state.json
config/*.tmp
*.db
*.db-wal
*.db-shm
# Paired-device registry written by connect/devices.py — holds live device
# tokens (plaintext); must never leave the machine.
data/connect/
# Task-engine markdown reports (contain machine paths); regenerated on demand.
data/reports/
# Orphaned IDE profile left by an old install; nothing references it.
_pynexa_profile.json

# ── Generated / scratch (cleaned up: keep them from coming back) ───────────
# Browser automation leftovers: the Chrome profile an old adapter created and
# its one-file sibling. Nothing in the code references either path.
data/browser_profile/
gmail_persistent_context_fix/
# Image-research output (actions/image_research.py recreates the folder).
researched_images/
# Diagnostics / runtime scratch dirs and the legacy root log dir.
_diag_out/
runtime/
logs/
jarvis_startup_error.log
dist/
build/

# ── Runtime scratch: logs, backups, browser-automation scratch, locks ──────
# All regenerated on demand. data/models/ is NOT ignored (bundled vision model).
data/logs/
config/backups/
data/automation/
# The knowledge library index and meeting recordings are private user data.
# The DB is already covered by *.db, but the extracted text, WAV files and
# Markdown notes must never be committed either.
data/library/
data/meetings/
data/runtime/
data/joptimizer/
data/mcp/

# ── Other coding agents' config (not used by J.A.R.V.I.S.) ─────────────────
.cline/
.clinerules/
.kilo/
.kilocode/
.opencode/
.agents/
.claude/

# ── Editor / OS ──────────────────────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini
*.bak
CHANGELOG_STAGE1.md
